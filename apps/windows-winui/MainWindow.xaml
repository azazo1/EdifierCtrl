<Window
    x:Class="EdifierCtrl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="4" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="12,60,12,18" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0,0,16">
                    <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource BrandBrush}">
                        <FontIcon Glyph="&#xE95B;" Foreground="White" FontSize="24"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="EdifierCtrl" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="声音, 随你而行" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="工作台" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="14,0"/>
                <ListView x:Name="Navigation" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnNavigation" Background="Transparent">
                    <ListViewItem Tag="headphones" Padding="12,13" CornerRadius="9" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7F6;" FontSize="17"/><TextBlock Text="我的耳机"/></StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="devices" Padding="12,13" CornerRadius="9" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE702;" FontSize="17"/><TextBlock Text="设备连接"/></StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="handoff" Padding="12,13" CornerRadius="9" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B5;" FontSize="17"/><TextBlock Text="跨设备交接"/></StackPanel>
                    </ListViewItem>
                </ListView>
                <ListView x:Name="FooterNavigation" Grid.Row="3" SelectionMode="Single" SelectionChanged="OnNavigation" Background="Transparent">
                    <ListViewItem Tag="settings" Padding="12,13" CornerRadius="9" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="17"/><TextBlock Text="应用设置"/></StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="activity" Padding="12,13" CornerRadius="9" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE9D9;" FontSize="17"/><TextBlock Text="活动记录"/></StackPanel>
                    </ListViewItem>
                </ListView>
                <StackPanel Grid.Row="4" Spacing="12" Margin="10,0">
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ServiceDot" Width="6" Height="6" Fill="{StaticResource BrandBrush}"/>
                        <TextBlock x:Name="ServiceLabel" Text="耳机服务启动中" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button x:Name="VersionButton" Click="OnVersion" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="12,8" FontSize="11" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="AppTitleBar" Grid.ColumnSpan="2" Background="Transparent" Height="40">
            <TextBlock Text="EdifierCtrl" FontSize="12" Margin="20,0,160,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Border>
        <Grid Grid.Column="1" Grid.Row="1" Padding="30,16,30,24" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="Bold"/>
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource MutedText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" MaxWidth="260">
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="18" Padding="12,7">
                    <TextBlock x:Name="ConnectionStatus" Text="未连接耳机" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="215"/>
                </Border>
            </StackPanel>
        </Grid>
        <Frame x:Name="ContentFrame" Grid.Column="1" Grid.Row="2" Background="Transparent"/>
        <InfoBar x:Name="Notice" Grid.Column="1" Grid.Row="3" Margin="28,8,28,20" IsOpen="False" IsClosable="True" Closed="OnNoticeClosed"/>
    </Grid>
</Window>
