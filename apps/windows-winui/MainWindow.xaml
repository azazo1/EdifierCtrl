<Window
    x:Class="EdifierCtrl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE95B;" FontSize="16"/>
                <TextBlock x:Name="TitleText" Text="EdifierCtrl" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>
        </Border>
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            SelectionChanged="OnNav">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="设备" Tag="device">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F3;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="控制" Tag="control">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="组" Tag="group">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="调试" Tag="debug">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEBE8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorder}" Margin="16,12,16,0">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="StatusLine" Text="未连接" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock x:Name="HintLine" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>
                <Frame x:Name="ContentFrame" Grid.Row="1" Padding="4"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
