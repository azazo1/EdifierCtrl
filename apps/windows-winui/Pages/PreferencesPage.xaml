<Page
    x:Class="EdifierCtrl.Pages.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource PageStack}" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="7"><TextBlock Text="后台与窗口" Style="{StaticResource SectionTitle}"/><TextBlock Text="关闭主窗口后, 耳机服务仍在系统托盘运行." Style="{StaticResource MutedText}"/></StackPanel>
                    <Grid ColumnSpacing="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6"><TextBlock Text="启动时隐藏主窗口" FontWeight="SemiBold"/><TextBlock Text="启动后通过系统托盘图标打开窗口" Style="{StaticResource MutedText}"/></StackPanel>
                        <ToggleSwitch x:Name="StartHiddenSwitch" Grid.Column="1" OnContent="开启" OffContent="关闭" Toggled="OnStartHidden" AutomationProperties.Name="启动时隐藏主窗口"/>
                    </Grid>
                    <Grid ColumnSpacing="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6"><TextBlock Text="启动时自动加入交接组" FontWeight="SemiBold"/><TextBlock x:Name="AutoJoinDetail" Text="需要先在交接页记住组名" Style="{StaticResource MutedText}"/></StackPanel>
                        <ToggleSwitch x:Name="AutoJoinSwitch" Grid.Column="1" OnContent="开启" OffContent="关闭" Toggled="OnAutoJoin" AutomationProperties.Name="启动时自动加入交接组"/>
                    </Grid>
                    <Button Content="管理交接组" Click="OnHandoff" Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                <StackPanel Spacing="18">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6"><TextBlock Text="应用主题" FontWeight="SemiBold"/><TextBlock Text="跟随 Windows 设置, 或为应用选择浅色和深色外观" Style="{StaticResource MutedText}"/></StackPanel>
                        <ComboBox x:Name="ThemeChoice" Grid.Column="1" MinWidth="180" SelectionChanged="OnTheme" VerticalAlignment="Center" AutomationProperties.Name="应用主题">
                            <ComboBoxItem Content="跟随系统" Tag="system"/>
                            <ComboBoxItem Content="浅色" Tag="light"/>
                            <ComboBoxItem Content="深色" Tag="dark"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                <StackPanel Spacing="22">
                    <StackPanel Spacing="7"><TextBlock Text="连接诊断" Style="{StaticResource SectionTitle}"/><TextBlock Text="遇到问题时, 查看活动记录或打开日志所在的数据目录." Style="{StaticResource MutedText}"/></StackPanel>
                    <Grid ColumnSpacing="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6"><TextBlock Text="详细日志" FontWeight="SemiBold"/><TextBlock Text="记录更多连接与生命周期细节" Style="{StaticResource MutedText}"/></StackPanel>
                        <ToggleSwitch x:Name="LoggingSwitch" Grid.Column="1" OnContent="开启" OffContent="关闭" Toggled="OnLogging" AutomationProperties.Name="详细日志"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="活动与诊断" Click="OnActivity" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="打开数据目录" Click="OnOpenData" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="蓝牙设置" Click="OnBluetooth" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="DataDirectoryText" Style="{StaticResource MutedText}" IsTextSelectionEnabled="True"/>
                    <TextBlock x:Name="LogFileText" Style="{StaticResource MutedText}" IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                <StackPanel Spacing="14">
                    <TextBlock Text="EdifierCtrl for Windows" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="CoreVersionText" Text="协议核心尚未加载" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="点击系统托盘图标可恢复主窗口. 如需完全结束后台连接与交接服务, 请退出应用." Style="{StaticResource MutedText}"/>
                    <Button Content="退出 EdifierCtrl" Click="OnQuit" Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>
            </Border>
            <InfoBar x:Name="SaveError" IsOpen="False" IsClosable="False" Severity="Error" Title="无法保存应用设置"/>
        </StackPanel>
    </ScrollViewer>
</Page>
