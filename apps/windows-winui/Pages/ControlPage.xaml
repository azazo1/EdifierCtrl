<Page
    x:Class="EdifierCtrl.Pages.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,24" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="控制" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock x:Name="Lead" Text="先到设备页连接耳机." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <TextBlock Text="降噪模式" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <RadioButtons x:Name="Modes" MaxColumns="3">
                <RadioButton Content="关闭" Tag="normal" Click="OnModeClick"/>
                <RadioButton Content="降噪" Tag="reduction" Click="OnModeClick"/>
                <RadioButton Content="通透" Tag="ambient" Click="OnModeClick"/>
            </RadioButtons>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="查电量" Click="OnBattery"/>
                <Button Content="读取状态" Click="OnReadout"/>
            </StackPanel>
            <Button Content="断开当前主机" Click="OnDisconnectHost"/>
        </StackPanel>
    </ScrollViewer>
</Page>
