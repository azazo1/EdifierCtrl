<Page
    x:Class="EdifierCtrl.Pages.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="控制" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Text="先在设备页连接耳机. 破坏性命令会走确认. 下方是耳机通知." TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="降噪关" Click="OnNormal"/>
            <Button Content="降噪" Click="OnAnc"/>
            <Button Content="通透" Click="OnAmbient"/>
            <Button Content="查电量" Click="OnBattery"/>
            <Button Content="读取状态" Click="OnReadout"/>
        </StackPanel>
        <Button Content="断开主机 (CD)" Click="OnDisconnectHost"/>
        <TextBlock x:Name="Log" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
