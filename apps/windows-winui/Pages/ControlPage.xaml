<Page
    x:Class="EdifierCtrl.Pages.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource PageStack}" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource HeroBorder}" Padding="22" CornerRadius="16">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="154" Height="174" VerticalAlignment="Center">
                        <Ellipse Width="148" Height="148" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.07"/>
                        <Ellipse Width="122" Height="122" Stroke="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.18"/>
                        <FontIcon Glyph="&#xE7F6;" FontSize="84" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="EDIFIER / PERSONAL AUDIO" FontSize="11" CharacterSpacing="150" Style="{StaticResource MutedText}"/>
                        <TextBlock x:Name="HeroName" Text="我的耳机" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <TextBlock x:Name="HeroStatus" Text="等待连接" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BatteryText" Text="电量: 等待耳机回报" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <TextBlock x:Name="HeroDetail" Text="控制音效, 管理连接, 在设备之间自由切换." Style="{StaticResource MutedText}"/>
                        <StackPanel x:Name="HeroActions" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                            <Button x:Name="ReadoutButton" Content="读取状态" Click="OnReadout" Style="{StaticResource ActionButtonStyle}"/>
                            <Button x:Name="DisconnectButton" Content="断开控制" Click="OnDisconnect" Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ConnectionEmpty" Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                <StackPanel Spacing="18" HorizontalAlignment="Center" Margin="12,18">
                    <FontIcon Glyph="&#xE702;" FontSize="34" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="准备好, 开始聆听" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="先在 Windows 蓝牙设置中完成配对, 再选择你的耳机. 连接后可调整降噪, 音效与更多选项." MaxWidth="570" TextAlignment="Center" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button x:Name="ConnectButton" Content="连接耳机" Click="OnDevices" Style="{StaticResource AccentButtonStyle}"/>
                        <Button x:Name="ReconnectButton" Content="连接上次的耳机" Click="OnReconnect" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ConnectedContent" Spacing="22" Visibility="Collapsed">
                <Border x:Name="NoiseCard" Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="聆听模式" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="隔绝喧闹, 或留意身边的声音." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <TextBlock x:Name="NoiseReading" Grid.Column="1" Text="等待耳机回报" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </Grid>
                        <ContentControl x:Name="NoiseChoices" HorizontalContentAlignment="Stretch" IsTabStop="False">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AmbientColumn" Width="*"/></Grid.ColumnDefinitions>
                                <ToggleButton x:Name="NoiseNormal" Tag="normal" Click="OnNoise" Style="{StaticResource ChoiceButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="116">
                                    <StackPanel Spacing="8"><FontIcon Glyph="&#xE767;" FontSize="23"/><TextBlock Text="标准" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="自然聆听" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="NoiseReduction" Grid.Column="1" Tag="reduction" Click="OnNoise" Style="{StaticResource ChoiceButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="116">
                                    <StackPanel Spacing="8"><FontIcon Glyph="&#xE74F;" FontSize="23"/><TextBlock Text="主动降噪" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="专注眼前" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="NoiseAmbient" Grid.Column="2" Tag="ambient" Click="OnNoise" Style="{StaticResource ChoiceButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="116">
                                    <StackPanel Spacing="8"><FontIcon Glyph="&#xE995;" FontSize="23"/><TextBlock Text="环境声" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="听见周围" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                                </ToggleButton>
                            </Grid>
                        </ContentControl>
                        <StackPanel x:Name="AmbientSection" Spacing="12">
                            <TextBlock Text="环境声强度" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AmbientReading" Style="{StaticResource MutedText}"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <NumberBox x:Name="AmbientInput" Minimum="-3" Maximum="3" SmallChange="1" LargeChange="1" SpinButtonPlacementMode="Inline" PlaceholderText="-3 至 3" ValueChanged="OnDraftValueChanged" AutomationProperties.Name="环境声强度"/>
                                <Button x:Name="AmbientApply" Grid.Column="1" Content="应用" Click="OnAmbient" Style="{StaticResource ActionButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="PlaybackColumn" Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="PlaybackCard" Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                        <StackPanel Spacing="18">
                            <TextBlock Text="播放控制" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="控制耳机正在播放的音频" Style="{StaticResource MutedText}"/>
                            <ContentControl x:Name="PlaybackActions" HorizontalContentAlignment="Stretch" IsTabStop="False">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Tag="previous" Click="OnPlayback" Style="{StaticResource IconButtonStyle}" Width="40" Height="40" ToolTipService.ToolTip="上一首" AutomationProperties.Name="上一首"><FontIcon Glyph="&#xE892;" FontSize="16"/></Button>
                                        <Button Tag="play" Click="OnPlayback" Style="{StaticResource IconButtonStyle}" Width="40" Height="40" ToolTipService.ToolTip="播放" AutomationProperties.Name="播放"><FontIcon Glyph="&#xE768;" FontSize="16"/></Button>
                                        <Button Tag="pause" Click="OnPlayback" Style="{StaticResource IconButtonStyle}" Width="40" Height="40" ToolTipService.ToolTip="暂停" AutomationProperties.Name="暂停"><FontIcon Glyph="&#xE769;" FontSize="16"/></Button>
                                        <Button Tag="next" Click="OnPlayback" Style="{StaticResource IconButtonStyle}" Width="40" Height="40" ToolTipService.ToolTip="下一首" AutomationProperties.Name="下一首"><FontIcon Glyph="&#xE893;" FontSize="16"/></Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Tag="volume_down" Click="OnPlayback" Style="{StaticResource IconButtonStyle}" Width="40" Height="40" ToolTipService.ToolTip="降低音量" AutomationProperties.Name="降低音量"><FontIcon Glyph="&#xE993;" FontSize="16"/></Button>
                                        <TextBlock Text="耳机音量" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <Button Tag="volume_up" Click="OnPlayback" Style="{StaticResource IconButtonStyle}" Width="40" Height="40" ToolTipService.ToolTip="提高音量" AutomationProperties.Name="提高音量"><FontIcon Glyph="&#xE995;" FontSize="16"/></Button>
                                    </StackPanel>
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                        <StackPanel Spacing="18">
                            <TextBlock Text="此刻的连接" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="AudioReading" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="控制通道已连接"/>
                            <TextBlock x:Name="GroupReading" Style="{StaticResource MutedText}"/>
                            <Button Content="前往交接" Click="OnHandoff" Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Expander x:Name="EffectExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Spacing="5"><TextBlock Text="声音风格" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="EffectReading" Text="找到适合当前音乐的音效." Style="{StaticResource MutedText}"/></StackPanel>
                    </Expander.Header>
                    <ContentControl x:Name="EffectChoices" HorizontalContentAlignment="Stretch" IsTabStop="False">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="EffectNormal" Content="标准" Tag="normal" Click="OnEffect" Style="{StaticResource ChoiceButtonStyle}" HorizontalAlignment="Stretch" MinHeight="66"/>
                            <ToggleButton x:Name="EffectPop" Grid.Column="1" Content="流行" Tag="pop" Click="OnEffect" Style="{StaticResource ChoiceButtonStyle}" HorizontalAlignment="Stretch" MinHeight="66"/>
                            <ToggleButton x:Name="EffectClassical" Grid.Column="2" Content="古典" Tag="classical" Click="OnEffect" Style="{StaticResource ChoiceButtonStyle}" HorizontalAlignment="Stretch" MinHeight="66"/>
                            <ToggleButton x:Name="EffectRock" Grid.Column="3" Content="摇滚" Tag="rock" Click="OnEffect" Style="{StaticResource ChoiceButtonStyle}" HorizontalAlignment="Stretch" MinHeight="66"/>
                        </Grid>
                    </ContentControl>
                </Expander>

                <Expander x:Name="SettingsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Spacing="5"><TextBlock Text="更多耳机设置" Style="{StaticResource SectionTitle}"/><TextBlock Text="提示音, 定时关机与按键偏好" Style="{StaticResource MutedText}"/></StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="22">
                        <Grid x:Name="GameSection" ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6"><TextBlock Text="低延迟游戏模式" FontWeight="SemiBold"/><TextBlock x:Name="GameReading" Style="{StaticResource MutedText}"/></StackPanel>
                            <ToggleSwitch x:Name="GameSwitch" Grid.Column="1" OnContent="开启" OffContent="关闭" Toggled="OnGame" AutomationProperties.Name="低延迟游戏模式"/>
                        </Grid>
                        <Grid x:Name="AutoOffSection" ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6"><TextBlock Text="空闲自动关机" FontWeight="SemiBold"/><TextBlock x:Name="AutoOffReading" Style="{StaticResource MutedText}"/></StackPanel>
                            <ToggleSwitch x:Name="AutoOffSwitch" Grid.Column="1" OnContent="开启" OffContent="关闭" Toggled="OnAutoOff" AutomationProperties.Name="空闲自动关机"/>
                        </Grid>
                        <StackPanel x:Name="PromptSection" Spacing="12">
                            <TextBlock Text="提示音量" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PromptReading" Style="{StaticResource MutedText}"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <NumberBox x:Name="PromptInput" Minimum="0" Maximum="15" SmallChange="1" LargeChange="1" SpinButtonPlacementMode="Inline" PlaceholderText="0 至 15" ValueChanged="OnDraftValueChanged" AutomationProperties.Name="提示音量"/>
                                <Button x:Name="PromptApply" Grid.Column="1" Content="应用" Click="OnPrompt" Style="{StaticResource ActionButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="TimerSection" Spacing="12">
                            <TextBlock Text="定时关机" FontWeight="SemiBold"/>
                            <TextBlock Text="设置仅在本次开机期间有效. 应用分钟数后开启定时." Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="TimerReading" Style="{StaticResource MutedText}"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <NumberBox x:Name="TimerInput" Minimum="1" Maximum="180" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Inline" PlaceholderText="1 至 180 分钟" ValueChanged="OnDraftValueChanged" AutomationProperties.Name="关机倒计时分钟数"/>
                                <Button x:Name="TimerApply" Grid.Column="1" Content="应用定时" Click="OnTimer" Style="{StaticResource ActionButtonStyle}"/>
                                <Button x:Name="TimerDisable" Grid.Column="2" Content="关闭定时" Click="OnDisableTimer" Style="{StaticResource ActionButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="ControlsSection" Spacing="12">
                            <TextBlock Text="耳机按键切换模式" FontWeight="SemiBold"/>
                            <TextBlock Text="至少选择两种模式, 按耳机按键时依次切换." Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="ControlsReading" Style="{StaticResource MutedText}"/>
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <CheckBox x:Name="ControlNormal" Content="标准" IsThreeState="True" Click="OnControlDraft"/>
                                <CheckBox x:Name="ControlReduction" Content="降噪" IsThreeState="True" Click="OnControlDraft"/>
                                <CheckBox x:Name="ControlAmbient" Content="环境声" IsThreeState="True" Click="OnControlDraft"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="ControlsApply" Content="应用按键模式" Click="OnApplyControls" Style="{StaticResource ActionButtonStyle}"/>
                                <Button x:Name="ControlsReset" Content="恢复读数" Click="OnResetControls" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="LdacSection" Spacing="12">
                            <TextBlock Text="LDAC 编码偏好" FontWeight="SemiBold"/>
                            <TextBlock Text="修改耳机端编码设置, 供支持 LDAC 的设备使用. 更改可能中断连接, 并关闭定时关机." Style="{StaticResource MutedText}"/>
                            <ComboBox x:Name="LdacChoice" MinWidth="250" SelectionChanged="OnLdac" AutomationProperties.Name="LDAC 编码偏好">
                                <ComboBoxItem Content="等待耳机回报" Tag="unknown" IsEnabled="False"/>
                                <ComboBoxItem Content="关闭" Tag="off"/>
                                <ComboBoxItem Content="44.1 / 48 kHz" Tag="rate48k"/>
                                <ComboBoxItem Content="96 kHz" Tag="rate96k"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="NameSection" Spacing="12">
                            <TextBlock Text="耳机名称" FontWeight="SemiBold"/>
                            <TextBlock x:Name="NameHint" Text="新名称可能需要移除系统配对记录并重新配对后显示." Style="{StaticResource MutedText}"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="NameInput" PlaceholderText="输入耳机名称" TextChanged="OnNameDraft" AutomationProperties.Name="耳机名称"/>
                                <Button x:Name="NameApply" Grid.Column="1" Content="应用名称" Click="OnSetName" Style="{StaticResource ActionButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                <StackPanel Spacing="18">
                    <TextBlock Text="设备信息" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="8"><TextBlock Text="固件版本" Style="{StaticResource MutedText}"/><TextBlock x:Name="FirmwareReading" Text="等待耳机回报" IsTextSelectionEnabled="True" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="蓝牙地址" Style="{StaticResource MutedText}"/><TextBlock x:Name="AddressReading" Text="等待耳机回报" IsTextSelectionEnabled="True" TextWrapping="Wrap"/></StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfileChoice" Header="机型档案" DisplayMemberPath="DisplayName" SelectedValuePath="Id" HorizontalAlignment="Stretch" SelectionChanged="OnProfile"/>
                        <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新状态" Click="OnReadout" VerticalAlignment="Bottom" Style="{StaticResource ActionButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="按机型显示支持的功能. 通用档案中的部分功能可能不被你的耳机支持." Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>

            <Expander x:Name="MaintenanceExpander" Header="设备维护" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Text="这些操作会中断当前连接. 恢复出厂还会清除耳机设置和配对记录." Style="{StaticResource MutedText}"/>
                    <ContentControl x:Name="MaintenanceActions" HorizontalContentAlignment="Stretch" IsTabStop="False">
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Button Content="释放当前主机" Tag="disconnect_host" Click="OnMaintenance" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="1" Content="关闭耳机" Tag="power_off" Click="OnMaintenance" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                            <Button Grid.Row="1" Content="重新配对" Tag="re_pair" Click="OnMaintenance" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="恢复出厂" Tag="factory_reset" Click="OnMaintenance" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </ContentControl>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
