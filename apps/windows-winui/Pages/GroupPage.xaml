<Page
    x:Class="EdifierCtrl.Pages.GroupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="组" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Text="加入后点某个成员, 会接管该成员正在持有的耳机." TextWrapping="Wrap"/>
        <TextBox x:Name="Passphrase" PlaceholderText="组口令"/>
        <Button Content="加入" Click="OnJoin"/>
        <TextBlock x:Name="GroupId" TextWrapping="Wrap"/>
        <Button Content="刷新成员" Click="OnRefresh"/>
        <ListView x:Name="Peers" Height="160" IsItemClickEnabled="True" ItemClick="OnPeerClick"/>
        <TextBox x:Name="Mac" PlaceholderText="耳机 MAC (成员未持有时用)"/>
        <Button Content="接管音频" Click="OnClaim"/>
        <TextBlock x:Name="Log" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
