<Page
    x:Class="EdifierCtrl.Pages.GroupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="组" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="同一局域网中使用相同组名的电脑和手机会互相发现. 点成员即可接管它正在用的耳机." Style="{StaticResource MutedText}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="10">
            <TextBox x:Name="Passphrase" Header="组名" PlaceholderText="例如 testhand"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="加入" Click="OnJoin" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="刷新" Click="OnRefresh"/>
            </StackPanel>
        </StackPanel>
        <ListView
            x:Name="Peers"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnPeerClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Host}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{Binding Id}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding HoldingText}"/>
                            <TextBlock Text="{Binding ActionText}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Expander Grid.Row="3" Header="用 MAC 接管" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBox x:Name="Mac" PlaceholderText="耳机 MAC"/>
                <Button Content="接管" Click="OnClaim"/>
            </StackPanel>
        </Expander>
    </Grid>
</Page>
