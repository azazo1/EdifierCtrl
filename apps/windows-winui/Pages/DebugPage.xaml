<Page
    x:Class="EdifierCtrl.Pages.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource PageStack}" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="7"><TextBlock Text="最近活动" Style="{StaticResource SectionTitle}"/><TextBlock Text="本次运行的操作, 连接与交接记录." Style="{StaticResource MutedText}"/></StackPanel>
                        <Button x:Name="ClearButton" Grid.Column="1" Content="清空记录" Click="OnClear" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="ActivitiesEmpty" Spacing="16" HorizontalAlignment="Center" Margin="12,24">
                        <FontIcon Glyph="&#xE9D9;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="当前没有活动" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="连接耳机, 调整设置或发起交接后, 操作记录会出现在这里." Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="530"/>
                    </StackPanel>
                    <ItemsControl x:Name="ActivitiesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,14" ColumnSpacing="14" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                                        <FontIcon Glyph="&#xEA39;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding NormalVisibility}"/>
                                        <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{Binding ErrorVisibility}" AutomationProperties.Name="错误"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="7">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" IsTextSelectionEnabled="True" Visibility="{Binding DetailVisibility}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" ToolTipService.ToolTip="{Binding FullTime}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Spacing="5"><TextBlock Text="协议诊断" Style="{StaticResource SectionTitle}"/><TextBlock Text="封装命令, 解析帧或向耳机发送 JSON" Style="{StaticResource MutedText}"/></StackPanel>
                </Expander.Header>
                <StackPanel Spacing="16">
                    <TextBlock Text="封装与解析只在本地处理. 发送 JSON 会实际操作当前耳机, 请确认命令内容. 诊断操作需要连接可控耳机." Style="{StaticResource MutedText}"/>
                    <TextBox x:Name="Payload" Header="JSON 命令或十六进制帧" PlaceholderText="输入命令 JSON 或帧 hex" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" TextChanged="OnPayloadChanged"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="EncodeButton" Content="封装 JSON 命令" Click="OnEncode" Style="{StaticResource ActionButtonStyle}"/>
                        <Button x:Name="ParseButton" Content="解析十六进制帧" Click="OnParse" Style="{StaticResource ActionButtonStyle}"/>
                        <Button x:Name="SendButton" Content="发送 JSON" Click="OnSend" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="DiagnosticState" Text="连接耳机后可使用协议诊断" Style="{StaticResource MutedText}"/>
                    <Border x:Name="ResultCard" Style="{StaticResource CardBorder}" Padding="18" CornerRadius="12" Visibility="Collapsed">
                        <TextBlock x:Name="Result" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
