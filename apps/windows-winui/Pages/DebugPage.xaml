<Page
    x:Class="EdifierCtrl.Pages.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="调试" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBox x:Name="Payload" PlaceholderText="命令 JSON 或帧 hex"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="封装命令" Click="OnEncode"/>
            <Button Content="解析帧" Click="OnParse"/>
            <Button Content="取事件" Click="OnPoll"/>
        </StackPanel>
        <TextBlock x:Name="Result" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
