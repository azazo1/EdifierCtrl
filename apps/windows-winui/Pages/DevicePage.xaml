<Page
    x:Class="EdifierCtrl.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource PageStack}" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE702;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBlock Text="从系统配对, 在这里连接" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="打开耳机并在 Windows 蓝牙设置中配对. 刷新列表后, 选择设备即可连接控制通道. 同组设备占用的耳机会合并到列表, 可直接请求接管." Style="{StaticResource MutedText}"/>
                        <HyperlinkButton Content="打开 Windows 蓝牙设置" Click="OnBluetooth" Padding="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchInput" PlaceholderText="搜索名称或蓝牙地址" TextChanged="OnSearch" AutomationProperties.Name="搜索设备"/>
                <Button x:Name="ScanButton" Grid.Column="1" Content="刷新设备" Click="OnScan" Style="{StaticResource AccentButtonStyle}"/>
            </Grid>
            <TextBlock x:Name="ListStatus" Text="默认使用经典蓝牙控制通道" Style="{StaticResource MutedText}"/>

            <Border x:Name="EmptyCard" Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16">
                <StackPanel Spacing="16" HorizontalAlignment="Center" Margin="12,18">
                    <FontIcon Glyph="&#xE7F6;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="EmptyTitle" Text="还没有找到耳机" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyDetail" Text="确认耳机已在系统中配对并打开, 然后刷新设备列表." MaxWidth="560" TextAlignment="Center" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="DevicesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="22" CornerRadius="16" Margin="0,0,0,14">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F6;" FontSize="30" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Address}" FontFamily="Consolas" Style="{StaticResource MutedText}" IsTextSelectionEnabled="True"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{Binding Action}" IsEnabled="{Binding Available}" Tag="{Binding}" Click="OnDevice" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander Header="使用蓝牙地址连接" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <TextBlock Text="适用于已经配对但未出现在列表中的耳机. 输入完整的蓝牙 MAC 地址." Style="{StaticResource MutedText}"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="AddressInput" PlaceholderText="AA:BB:CC:DD:EE:FF" FontFamily="Consolas" TextChanged="OnAddress" AutomationProperties.Name="手工连接蓝牙地址"/>
                        <Button x:Name="ConnectAddressButton" Grid.Column="1" Content="连接" Click="OnConnectAddress" Style="{StaticResource ActionButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Expander>
            <Expander Header="连接方式" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <TextBlock Text="日常使用经典蓝牙 (RFCOMM). 仅在耳机支持 BLE 控制时选择低功耗蓝牙, 更改后请刷新设备列表." Style="{StaticResource MutedText}"/>
                    <ComboBox x:Name="KindChoice" SelectedIndex="0" SelectionChanged="OnKind" MinWidth="260" AutomationProperties.Name="扫描和连接方式">
                        <ComboBoxItem Content="经典蓝牙 (RFCOMM)" Tag="rfcomm"/>
                        <ComboBoxItem Content="低功耗蓝牙 (BLE)" Tag="ble"/>
                    </ComboBox>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
