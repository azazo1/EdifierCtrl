<Page
    x:Class="EdifierCtrl.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Style="{StaticResource PageRoot}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="设备" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="只列出已配对的漫步者耳机. 被其他主机占用时点列表即可接管." Style="{StaticResource MutedText}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <RadioButtons x:Name="Kind" MaxColumns="2" SelectedIndex="0">
                    <RadioButton Content="经典蓝牙" Tag="rfcomm"/>
                    <RadioButton Content="BLE" Tag="ble"/>
                </RadioButtons>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="扫描" Click="OnScan" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="断开" Click="OnDisconnect"/>
            </StackPanel>
            <ListView
                x:Name="Devices"
                Grid.Row="3"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="OnDeviceClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4,8" Spacing="2">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{Binding Address}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding Action}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </ScrollViewer>
</Page>
